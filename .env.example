# kintsugi configuration. Copy to .env (gitignored) and fill in the values;
# they are exported into the process env, e.g.
#   node --env-file=.env dist/src/receiver/app.js
# Every variable is optional: unset (or blank) disables the feature that uses
# it, never the process.

# Receiver port. Precedence: PORT, then KINTSUGI_PORT, then 8080 — an invalid
# or blank value falls through to the next source instead of crashing startup.
PORT=8080
KINTSUGI_PORT=

# Bearer token guarding the dashboard; unset disables auth for local use.
DASHBOARD_TOKEN=

# Nebius LLM credentials; unset disables all LLM-backed repair flows.
NEBIUS_API_KEY=
# Override of the provider API base URL; blank means the built-in default.
NEBIUS_BASE_URL=

# Model ids for the fast / reasoning / judge roles; each used verbatim.
MODEL_FAST=
MODEL_REASON=
MODEL_JUDGE=

# Telegram notifier credentials; either one unset keeps the notifier off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opt-in Tier-2 approval cards over Telegram. Only the exact value `true`
# (trimmed, case-insensitive) enables sends; unset/blank/anything else keeps
# the notifier off with zero outbound network calls (the default).
TELEGRAM_NOTIFIER_ENABLED=
# Override of the Telegram Bot API base URL (tests point it at a stub
# server); blank means the built-in default https://api.telegram.org.
TELEGRAM_API_BASE_URL=

# SQLite database file for repair events, snapshots, decisions, LLM traces and
# metrics; blank means the consumer wiring applies its default (kintsugi.db in
# the working directory). Use ":memory:" only for scratch/testing.
KINTSUGI_DB_PATH=

# n8n instance root URL (the client appends /api/v1, e.g. https://n8n.techa.pro)
# and its API key; both unset (or either blank) keeps every n8n-backed flow off.
N8N_BASE_URL=
N8N_API_KEY=

# Mock-upstream chaos service root driving the demo workflow HTTP node
# (<base>/api/users); blank means the seeder default http://localhost:3001.
MOCK_UPSTREAM_URL=
# Public Kintsugi root used to build the error-trigger /error-hook target
# (<base>/error-hook); blank means http://localhost:<port>/error-hook.
KINTSUGI_PUBLIC_URL=
