# kintsugi configuration. Copy to .env (gitignored) and fill in the values;
# they are exported into the process env, e.g.
#   node --env-file=.env dist/src/receiver/app.js
# Every variable is optional: unset (or blank) disables the feature that uses
# it, never the process.

# Receiver port. Precedence: PORT, then KINTSUGI_PORT, then 8080 — an invalid
# or blank value falls through to the next source instead of crashing startup.
PORT=8080
KINTSUGI_PORT=

# Bearer token guarding the dashboard; unset disables auth for local use.
DASHBOARD_TOKEN=

# Nebius LLM credentials; unset disables all LLM-backed repair flows.
NEBIUS_API_KEY=
# Override of the provider API base URL; blank means the built-in default.
NEBIUS_BASE_URL=

# Model ids for the fast / reasoning / judge roles; each used verbatim.
MODEL_FAST=
MODEL_REASON=
MODEL_JUDGE=

# Telegram notifier credentials; either one unset keeps the notifier off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite database file for repair events, snapshots, decisions, LLM traces and
# metrics; blank means the consumer wiring applies its default (kintsugi.db in
# the working directory). Use ":memory:" only for scratch/testing.
KINTSUGI_DB_PATH=
