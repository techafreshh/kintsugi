    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@hono/node-server": "^2.1.5",
    "@sinclair/typebox": "^0.34.0",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
