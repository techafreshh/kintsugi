{
  "name": "kintsugi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kintsugi": "bin/kintsugi",
    "kintsugi-mock-upstream": "dist/src/mockupstream/app.js",
    "mock-upstream": "dist/src/mockupstream/app.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
